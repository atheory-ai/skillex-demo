{
  "name": "demo-skillex-monorepo",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev:admin": "pnpm --filter @demo/admin dev",
    "dev:storefront": "pnpm --filter @demo/storefront dev",
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' build",
    "typecheck": "pnpm -r --filter './packages/**' --filter './apps/**' typecheck",
    "lint": "pnpm -r --filter './packages/**' --filter './apps/**' lint",
    "skillex:refresh": "skillex refresh",
    "skillex:verify": "node scripts/verify-skills.mjs",
    "skillex:check": "skillex refresh --check && skillex test validate --check"
  },
  "devDependencies": {
    "@atheory-ai/skillex": "0.9.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
